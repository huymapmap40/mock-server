# ---------------------------------------------------------------------------
# Mock server configuration
# Copy this file to ".env" and adjust the values for your environment.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
# Host the mock server binds to. For local development keep this as localhost.
MOCK_SERVER_HOST=localhost
# Port the mock server listens on. Must be free on the machine.
MOCK_SERVER_PORT=1080
# Log every request/response interaction to the console (true|false).
MOCK_SERVER_VERBOSE=true
# Set the underlying MockServer log level to TRACE (very chatty, true|false).
MOCK_SERVER_TRACE=false
# MockServer (netty jar) version to run. 5.15.0 is bundled with mockserver-node.
MOCK_SERVER_VERSION=5.15.0

# --- Contracts -------------------------------------------------------------
# Directory (relative to the project root) holding the per-API YAML contracts.
CONTRACTS_DIR=expectations

# --- CORS ------------------------------------------------------------------
# Enable CORS for all responses (true|false).
CORS_ENABLED=true
# Allowed origin. With credentials enabled the spec forbids "*", so pin a
# specific origin (your frontend / caller), e.g. http://localhost:3000.
CORS_ALLOW_ORIGIN=http://localhost:3000
CORS_ALLOW_METHODS=CONNECT, DELETE, GET, HEAD, OPTIONS, POST, PUT, PATCH, TRACE
CORS_ALLOW_HEADERS=Allow, Content-Encoding, Content-Length, Content-Type, ETag, Expires, Last-Modified, Location, Server, Vary, Authorization
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=300

# --- JWT / RBAC ------------------------------------------------------------
# Shared HS256 secret used to sign and verify mock tokens. Change for shared
# environments. Tokens are minted with: npm run token -- --service X --roles a,b
JWT_SECRET=dev-mock-secret-change-me
# Expected token issuer (iss claim).
JWT_ISSUER=mock-server
# Default token lifetime (e.g. 1h, 30m, or a number of seconds).
JWT_EXPIRES_IN=1h

# --- Datadog Logging -------------------------------------------------------
# Set DD_ENABLED=true to ship logs to Datadog in addition to stdout.
DD_ENABLED=false
# API key (not client token) from https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=
# Intake site: datadoghq.com (US1), us5.datadoghq.com (US5), datadoghq.eu (EU1)
DD_SITE=datadoghq.com
# Logical service name shown in Datadog Log Explorer
DD_SERVICE=mock-server
# Environment tag — helps filter by stage in Log Explorer
DD_ENV=local
